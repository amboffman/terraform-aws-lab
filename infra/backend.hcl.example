# Copy to backend.hcl and paste the bucket name from the bootstrap output.
bucket       = "tf-lab-tfstate-123456789012"
key          = "infra/terraform.tfstate"
region       = "us-west-2"
profile      = "tf-lab"
encrypt      = true
use_lockfile = true # S3 native state locking, no DynamoDB table needed (Terraform 1.10+)
